# Express API settings. The Vite development server uses port 3000.
BACKEND_PORT=5001
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
DB_NAME=Brand_Review_Desk

# Secret used to sign portal session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret
# Session lifetime in seconds (default 7 days).
AUTH_TOKEN_TTL=604800

# Optional DNS resolvers for MongoDB Atlas SRV lookups.
# DNS_SERVERS=8.8.8.8,1.1.1.1
